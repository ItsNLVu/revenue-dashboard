# PostgreSQL connection. Matches the database/user created in the README (and docker-compose.yml)
DATABASE_URL="postgresql://revenue:revenue@localhost:5432/revenue_dashboard?schema=public"

# Port of this API
PORT=4000

# Secret used to sign admin session tokens. Generate your own with:  openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# Frontend origin allowed by CORS (only needed if the browser calls the API directly)
CORS_ORIGIN="http://localhost:3000"

# Optional: timezone that decides which week is "this week" (defaults to the server's timezone)
# APP_TIMEZONE="Asia/Ho_Chi_Minh"

# Admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"
